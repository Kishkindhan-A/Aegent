APP_NAME=Aegent
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://aegent:aegent@localhost:5432/aegent
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
APPROVAL_REQUEST_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
TRUSTED_HOSTS=localhost,127.0.0.1,[::1],testserver
MAX_REQUEST_SIZE_BYTES=1048576
RATE_LIMIT_REQUESTS_PER_MINUTE=60
