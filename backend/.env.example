APP_NAME=Aegent
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/aegent
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
APPROVAL_REQUEST_EXPIRE_MINUTES=60
